#!/bin/sh
# /etc/uci-defaults/90-pbr-lite-firstrun
#
# 首次安装后的兜底：如果还没有生成过 include（从没跑过更新），后台跑一次，
# 并且不阻塞开机 —— 下载可能要十几秒，卡在 uci-defaults 里会让整台机器晚起来。
#
# 失败也没关系：没有 include 就只是「不打标、全部直连」，上网不受影响，
# 下次 cron 或手动跑一次 pbr-lite-update 就补上了。
#
# uci-defaults 的约定：退出码 0 表示这条脚本已被成功执行，可以从目录里删掉。
# 这里只在「确实已经装好规则」时才 exit 0，否则保留脚本，等下次开机再试。

INC='/usr/share/nftables.d/ruleset-post/30-pbr-lite.nft'

if [ -f "$INC" ]; then
    exit 0
fi

/usr/sbin/pbr-lite-update --force >/dev/null 2>&1 &

exit 1
